/dts-v1/;
/plugin/;

/ {
	fragment@0 {
		target-path = "/";
		__overlay__ {
			bootcount0 {
				compatible = "u-boot,bootcount-rtc";
				rtc = <&rtc_i2c>;
				offset = <0x20>;
			};

			wdt_gpio: wdt-gpio {
				compatible = "linux,wdt-gpio";
				hw_margin_ms = <4000>;
				hw_algo = "level";
				pinctrl-names = "default";
				timeout-sec = <10>;
				pinctrl-0 = <&wd_pins>;
				gpios = <&gpio 27 0>;
				status = "okay";
			};
		};
	};

	fragment@1 {
		target = <&i2c1>;

		__overlay__ {
			#address-cells = < 0x01 >;
			#size-cells = < 0x00 >;
			status = "okay";

			unipi_mb:24c01@57 {
				compatible = "atmel,24c01";
				reg = <0x57>;
				read-only;
				status = "okay";
			};

			rtc_i2c:mcp7940x@6f {
				compatible = "microchip,mcp7941x";
				reg = <0x6f>;
				status = "okay";
			};
		};
	};

	fragment@2 {
		target-path = "/aliases";
		__overlay__ {
			unipi_mb = &unipi_mb;
		};
	};

	fragment@3 {
		target = <&gpio>;
		__overlay__ {
			wd_pins: wd-pins {
				brcm,pins = <27>;
				brcm,function = <1>;
			};
		};
	};
};
